           <item>
            <widget class="QFrame" name="candidateHeaderCard">
             <property name="styleSheet">
              <string notr="true">
QFrame#candidateHeaderCard {
    background-color: #ffffff;
    border: 1px solid #eef2f7;
    border-radius: 14px;
}
QLabel#candidatePageTitle {
    color: #0f172a;
    font-family: "Segoe UI", "Inter";
    font-size: 24px;
    font-weight: 800;
    background: transparent;
    border: none;
}
QLabel#candidatePageSubtitle {
    color: #64748b;
    font-family: "Segoe UI", "Inter";
    font-size: 13px;
    font-weight: 500;
    background: transparent;
    border: none;
}
QFrame#candidateSearchFrame {
    background-color: #f8fafc;
    border: 1px solid #dbe3ef;
    border-radius: 22px;
}
QFrame#candidateSearchFrame:focus-within {
    background-color: #ffffff;
    border: 1px solid #3b82f6;
}
QLabel#candidateSearchIcon {
    color: #94a3b8;
    font-family: "Segoe UI", "Inter";
    font-size: 17px;
    font-weight: 700;
    background: transparent;
    border: none;
}
QLineEdit#lineCandidateSearch {
    background: transparent;
    border: none;
    color: #0f172a;
    font-family: "Segoe UI", "Inter";
    font-size: 13px;
    padding: 0px;
}
QPushButton#btnCandidateSearchClear {
    background-color: #e2e8f0;
    color: #64748b;
    border: none;
    border-radius: 11px;
    font-size: 14px;
    font-weight: 800;
}
QPushButton#btnCandidateSearchClear:hover {
    background-color: #cbd5e1;
    color: #0f172a;
}
QComboBox.candidateFilterChip {
    background-color: #f8fafc;
    border: 1px solid #dbe3ef;
    border-radius: 19px;
    padding: 0px 16px;
    color: #334155;
    font-family: "Segoe UI", "Inter";
    font-size: 13px;
    font-weight: 600;
}
QComboBox.candidateFilterChip:hover {
    background-color: #f1f5f9;
    border-color: #bfdbfe;
}
QComboBox.candidateFilterChip:focus {
    background-color: #ffffff;
    border-color: #3b82f6;
}
QComboBox.candidateFilterChip::drop-down {
    border: none;
    width: 30px;
}
QComboBox.candidateFilterChip QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #dbe3ef;
    border-radius: 10px;
    selection-background-color: #eff6ff;
    selection-color: #2563eb;
    padding: 6px;
}
QPushButton#btnCandidateClearFilters {
    background-color: transparent;
    color: #ef4444;
    border: none;
    border-radius: 19px;
    padding: 0px 14px;
    font-family: "Segoe UI", "Inter";
    font-size: 13px;
    font-weight: 700;
}
QPushButton#btnCandidateClearFilters:hover {
    background-color: #fef2f2;
    color: #dc2626;
}
              </string>
             </property>
