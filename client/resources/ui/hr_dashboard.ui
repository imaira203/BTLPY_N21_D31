              <string notr="true">
QFrame#candidateTableCard {
    background-color: #ffffff;
    border: 1px solid #eef2f7;
    border-radius: 14px;
}
QLabel#candidateListIcon {
    background-color: #eff6ff;
    color: #3b82f6;
    border: none;
    border-radius: 16px;
    font-family: "Segoe UI", "Inter";
    font-size: 16px;
    font-weight: 800;
}
QLabel#candidateListTitle {
    color: #0f172a;
    background: transparent;
    border: none;
    font-family: "Segoe UI", "Inter";
    font-size: 16px;
    font-weight: 800;
}
QLabel#labelCandidateCount {
    background-color: #eff6ff;
    color: #2563eb;
    border: none;
    border-radius: 10px;
    padding: 3px 10px;
    font-family: "Segoe UI", "Inter";
    font-size: 11px;
    font-weight: 800;
}
QTableWidget#tableCands {
    background-color: #ffffff;
    alternate-background-color: #fbfdff;
    border: none;
    gridline-color: #eef2f7;
    color: #334155;
    font-family: "Segoe UI", "Inter";
    font-size: 13px;
    selection-background-color: #eff6ff;
    selection-color: #1d4ed8;
    outline: none;
}
QTableWidget#tableCands::item {
    padding: 10px 14px;
    border: none;
    border-bottom: 1px solid #eef2f7;
}
QTableWidget#tableCands::item:hover {
    background-color: #f1f5f9;
}
QTableWidget#tableCands::item:selected {
    background-color: #eff6ff;
    color: #1d4ed8;
}
QTableWidget#tableCands QHeaderView::section {
    background-color: #f8fafc;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    padding: 12px 10px;
    color: #64748b;
    font-family: "Segoe UI", "Inter";
    font-size: 11px;
    font-weight: 800;
}
QFrame#candidateEmptyState {
    background-color: #f8fafc;
    border: 1px dashed #dbe3ef;
    border-radius: 12px;
}
QLabel#candidateEmptyIcon {
    background-color: #eff6ff;
    color: #3b82f6;
    border: none;
    border-radius: 19px;
    font-family: "Segoe UI", "Inter";
    font-size: 18px;
    font-weight: 800;
}
QLabel#candidateEmptyTitle {
    color: #0f172a;
    background: transparent;
    border: none;
    font-family: "Segoe UI", "Inter";
    font-size: 14px;
    font-weight: 800;
}
QLabel#candidateEmptySubtitle {
    color: #64748b;
    background: transparent;
    border: none;
    font-family: "Segoe UI", "Inter";
    font-size: 12px;
}
QFrame#candidatePaginationBar {
    background-color: transparent;
    border: none;
}
QPushButton.candidatePaginationButton {
    background-color: #f8fafc;
    color: #475569;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0px 12px;
    font-family: "Segoe UI", "Inter";
    font-size: 13px;
    font-weight: 600;
}
QPushButton.candidatePaginationButton:hover {
    background-color: #eff6ff;
    color: #2563eb;
    border-color: #bfdbfe;
}
